# PostPilot Environment Variables (Sanitized Example)
# Public Client-side Firebase Configuration (Zero Private Keys)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDummyKeyForPostPilotConfig"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="postpilot-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="postpilot-app"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="postpilot-app.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Server-Side Only Webhooks & Secrets
MAKE_WEBHOOK_URL="https://hook.eu1.make.com/your-custom-webhook-endpoint"
APP_BASE_URL="http://localhost:3000"
