rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /workspaces/{workspaceId}/posts/{allPaths=**} {
      // Lecture publique des visuels approuvés ou en revue
      allow read: if true;

      // Upload réservé aux admins et contrôlé en type et taille (max 25MB)
      allow write: if request.auth != null
                   && request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }
  }
}
